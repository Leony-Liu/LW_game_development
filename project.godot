"res://Scene/Battle_Scene_Enemy/EnemyVisuals/Arts/": "purple",
"res://Scene/Battle_Scene_Enemy/Scripts/": "yellow",
"res://Scene/Battle_Scene_Main/": "blue",
"res://Scene/Battle_Scene_Main/Arts/": "purple",
"res://Scene/Battle_Scene_Main/EnemyHPBar/": "blue",
"res://Scene/Battle_Scene_Main/PlayerInformation/": "blue",
"res://Scene/Battle_Scene_Main/Scripts/": "yellow",
"res://Scene/Battle_Scene_Player/Arts/": "purple",
"res://Scene/Battle_Scene_Player/Scripts/": "yellow",
"res://Scene/Battle_Scene_Player/player-visuals/Arts/": "purple",
"res://Scene/Battle_Scene_Player/player_3Dvisuals/Arts/": "purple",
"res://Scene/Battle_Scene_Player/player_3Dvisuals/Scripts/": "yellow",
"res://Scene/Card_Scene/": "blue",
"res://Scene/Card_Scene/Arts/": "purple",
"res://Scene/Card_Scene/Scripts/": "yellow",
"res://Scene/DungeonScene/": "blue",
"res://Scene/DungeonScene/Arts/": "purple",
"res://Scene/DungeonScene/Script/": "yellow",
"res://Scene/Dungeon_Enemy_Scene/Art/": "purple",
"res://Scene/Dungeon_Player_Scene/Art/": "purple",
"res://Scene/Dungeon_Player_Scene/Scripts/": "yellow",
"res://Scene/Main_Scene/Scripts/": "yellow"
}

