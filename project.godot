; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="LW_game_development"
run/main_scene="uid://bwljaaods183o"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

UIManager="*res://JourneySystem/SearchSystem/Script/Manager/ui_manager.gd"
ItemDataBase="*res://JourneySystem/SearchSystem/Script/Data/item_data_base.gd"
MAPInventoryManager="*res://JourneySystem/SearchSystem/Script/Manager/inventory_system.gd"
SearchManager="*res://JourneySystem/SearchSystem/Script/Manager/search_manager.gd"
InteractionManager="*res://JourneySystem/SearchSystem/Script/Manager/interaction_manager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
EventBus="*res://JourneySystem/event_bus.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/godot_omni/plugin.cfg")

[file_customization]

folder_colors={
"res://Arts/": "purple",
"res://Arts/Fort/": "purple",
"res://Arts/Theme/": "purple",
"res://Audio/": "green",
"res://DataBase/": "red",
"res://ExpeditionSystem/BattleSystem/CardSystem/Arts/": "purple",
"res://ExpeditionSystem/BattleSystem/CardSystem/Scripts/": "yellow",
"res://ExpeditionSystem/BattleSystem/CombatSystem/ProcessorSystem/Scripts/": "yellow",
"res://ExpeditionSystem/BattleSystem/CombatSystem/Scripts/": "yellow",
"res://ExpeditionSystem/BattleSystem/Scripts/": "yellow",
"res://ExpeditionSystem/Scripts/": "yellow",
"res://ExpeditionSystem/WorldSystem/PlayerVisual/Scripts/": "yellow",
"res://ExpeditionSystem/WorldSystem/RoomSystem/Scripts/": "yellow",
"res://ExpeditionSystem/WorldSystem/Scripts/": "yellow",
"res://JourneySystem/EnemySystem/Art/": "purple",
"res://JourneySystem/EnemySystem/SceneAssets/": "green",
"res://JourneySystem/EnemySystem/Scripts/": "yellow",
"res://JourneySystem/PlayerSystem/Art/": "purple",
"res://JourneySystem/PlayerSystem/SceneAssets/": "green",
"res://JourneySystem/PlayerSystem/Scripts/": "yellow",
"res://JourneySystem/RoomSystem/Art/": "purple",
"res://JourneySystem/RoomSystem/Data/": "red",
"res://JourneySystem/RoomSystem/ScenesAssets/": "green",
"res://JourneySystem/RoomSystem/Scripts/": "yellow",
"res://JourneySystem/SearchSystem/SceneAssets/": "teal",
"res://JourneySystem/UI/Scripts/": "yellow",
"res://Localization/": "pink"
}

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="uid://wupdljc1nnfi"
theme/custom_font="uid://jdg6h0onc3a1"

