; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="LW_game_development"
run/main_scene="uid://0rtgdscsodly"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://Scripts/GameManager.gd"
SaveManager="*res://Scripts/SaveManager.gd"
AllCardData="*res://Scripts/CardData/AllCardData.gd"
AllEnemyData="*res://Scripts/EnemyData/AllEnemyData.gd"
EventBus="*res://Scene/Main_Scene/Scripts/event_bus.gd"
BattleBus="*res://Scene/Battle_Scene/Battle_Scene_Main/Scripts/battle_bus.gd"
CardDataBase="*res://Scene/Main_Scene/Scripts/Manager/card_database_manager.gd"
MechanicDatabaseManager="*res://Scene/Main_Scene/Scripts/Manager/enemymechanic_database_manager.gd"
SettingsManager="*res://Scene/Main_Scene/Scripts/Manager/settings_manager.gd"
PlayerDeckManager="*res://Scene/Battle_Scene/Battle_Scene_Main/Scripts/player_deck_manager.gd"
ItemDatabaseManager="*res://Scene/Main_Scene/Scripts/Manager/item_database_manager.gd"
PlayerInventoryCore="*res://Scene/Main_Scene/Scripts/Shared/Inventory/player_inventory_core.gd"
RaidInventoryBridge="*res://Scene/Main_Scene/Scripts/Shared/Inventory/raid_inventory_bridge.gd"
UIManager="*res://JourneySystem/SearchSystem/Script/Manager/ui_manager.gd"
ItemDataBase="*res://JourneySystem/SearchSystem/Script/Data/item_data_base.gd"
MAPInventoryManager="*res://JourneySystem/SearchSystem/Script/Manager/inventory_system.gd"
SearchManager="*res://JourneySystem/SearchSystem/Script/Manager/search_manager.gd"
InteractionManager="*res://JourneySystem/SearchSystem/Script/Manager/interaction_manager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/godot_omni/plugin.cfg")

[file_customization]

folder_colors={
"res://Arts/": "purple",
"res://Arts/Fort/": "purple",
"res://Arts/Theme/": "purple",
"res://Audio/": "green",
"res://DataBase/": "red",
"res://ExpeditionSystem/BattleSystem/CardSystem/Arts/": "purple",
"res://ExpeditionSystem/BattleSystem/CardSystem/Scripts/": "yellow",
"res://ExpeditionSystem/BattleSystem/CombatSystem/ProcessorSystem/Scripts/": "yellow",
"res://ExpeditionSystem/BattleSystem/CombatSystem/Scripts/": "yellow",
"res://ExpeditionSystem/BattleSystem/Scripts/": "yellow",
"res://ExpeditionSystem/Scripts/": "yellow",
"res://ExpeditionSystem/WorldSystem/PlayerVisual/Scripts/": "yellow",
"res://ExpeditionSystem/WorldSystem/RoomSystem/Scripts/": "yellow",
"res://ExpeditionSystem/WorldSystem/Scripts/": "yellow",
"res://JourneySystem/RoomSystem/Art/": "purple",
"res://JourneySystem/RoomSystem/Data/": "red",
"res://JourneySystem/RoomSystem/ScenesAssets/": "green",
"res://JourneySystem/RoomSystem/Scripts/": "yellow",
